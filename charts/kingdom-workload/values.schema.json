{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["workloads"],
  "properties": {
    "stack": {"type": "string", "maxLength": 63, "pattern": "^([A-Za-z0-9][A-Za-z0-9_-]*)?$"},
    "workloads": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
      "additionalProperties": {"$ref": "#/definitions/workload"}
    },
    "resources": {"type": "array", "items": {"type": "object", "required": ["apiVersion", "kind", "metadata"], "properties": {
      "apiVersion": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
      "metadata": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    }}}
  },
  "definitions": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "containers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "image"], "properties": {"name": {"type": "string", "minLength": 1}, "image": {"type": "string", "minLength": 1}}}},
    "workload": {
      "type": "object", "additionalProperties": false, "required": ["podSpec"],
      "properties": {
        "kind": {"type": "string", "enum": ["Deployment", "StatefulSet", "Job"]},
        "stack": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "replicas": {"type": "integer", "minimum": 0},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/stringMap"},
        "telemetry": {"type": "object", "additionalProperties": false, "required": ["traces"], "properties": {"traces": {"type": "boolean"}}},
        "podSpec": {"type": "object", "required": ["containers"], "properties": {"containers": {"$ref": "#/definitions/containers"}, "initContainers": {"$ref": "#/definitions/containers"}}},
        "workloadSpec": {"type": "object", "properties": {"template": false, "selector": false, "replicas": false}},
        "service": {"type": "object", "required": ["ports"], "properties": {"selector": false, "ports": {"type": "array", "minItems": 1}}}
      }
    }
  }
}
