{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "replicas",
    "podSpec"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "podSpec": {
      "type": "object",
      "required": [
        "containers"
      ],
      "properties": {
        "containers": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "ports": {
          "type": "array"
        }
      }
    },
    "application": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(|v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$"
        }
      },
      "additionalProperties": false
    }
  }
}
